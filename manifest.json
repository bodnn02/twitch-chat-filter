{
    "manifest_version": 3,
    "name": "Chat Filter for Twitch",
    "version": "1.4",
    "description": "Show only the Twitch chat users you pick, or hide the ones you don't want, in a separate filtered chat.",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "*://*.twitch.tv/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.twitch.tv/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "styles.css"
            ],
            "matches": [
                "*://*.twitch.tv/*"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Chat Filter for Twitch"
    },
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}